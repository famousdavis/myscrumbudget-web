# Firebase configuration for spert-suite
# Copy this file to .env.local and fill in values from Firebase Console
# All SPERT suite apps share the same Firebase project (spert-suite)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=spert-suite.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=spert-suite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=spert-suite.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id-here
