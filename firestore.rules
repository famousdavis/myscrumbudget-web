// ⚠️ REFERENCE-ONLY / HISTORICAL — DO NOT DEPLOY FROM THIS FILE
//
// The canonical SPERT-suite-wide Firestore rules live in the Landing
// Page repo (/Users/william/Documents/spert-landing-page/firestore.rules)
// since May 2026. This file remains for historical reference and may
// be deleted in a future cleanup pass. Do not edit and deploy from
// here — changes will not propagate to production.
//
// Deploy workflow: paste-replace into the Firebase Console (canonical),
// or `firebase deploy --only firestore:rules --project spert-suite`
// from the Landing Page repo (fallback). See the canonical guide at
// /Users/william/Documents/SPERT Documentation/cloud-storage-guide/ARCHITECTURE.md
// §21.11.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // ── MyScrumBudget Projects ──
    match /myscrumbudget_projects/{projectId} {
      // List: allow for all authenticated users; client-side filters by membership.
      // Map-key membership cannot be matched by Firestore query constraints,
      // so list must be broadly allowed. Write ops are fully protected.
      allow list: if isAuth();

      // Get: only members can read individual docs
      allow get: if isAuth() &&
        request.auth.uid in resource.data.members;

      // Create: authenticated user must set themselves as owner
      allow create: if isAuth() &&
        request.resource.data.members[request.auth.uid] == 'owner';

      // Update: only owner or editor; owner field must not change
      allow update: if isAuth() &&
        request.auth.uid in resource.data.members &&
        (resource.data.members[request.auth.uid] == 'owner' ||
         resource.data.members[request.auth.uid] == 'editor');

      // Delete: only owner
      allow delete: if isAuth() &&
        resource.data.members[request.auth.uid] == 'owner';
    }

    // ── MyScrumBudget User Profiles ──
    // Readable by any authenticated user (for email lookup in sharing),
    // writable only by the profile owner.
    match /myscrumbudget_profiles/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // ── MyScrumBudget User Settings ──
    // Readable and writable only by the owner.
    match /myscrumbudget_settings/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
  }
}
